#!/bin/sh
# Mirrors the CI checks in .github/workflows/ci.yml so a push never reaches
# GitHub with something CI would have rejected anyway.
set -e

echo "pre-push: ruff check"
uv run ruff check .

echo "pre-push: ruff format --check"
uv run ruff format --check .

echo "pre-push: pytest"
uv run pytest -q
