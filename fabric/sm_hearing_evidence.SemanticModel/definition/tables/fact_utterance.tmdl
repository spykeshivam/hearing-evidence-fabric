table fact_utterance
	lineageTag: 2de02b50-45b2-4ec3-8cc6-652683236b6e
	sourceLineageTag: [dbo].[fact_utterance]

	measure 'Speaking Minutes' = DIVIDE ( SUM ( fact_utterance[duration_s] ), 60 )
		lineageTag: 1e57a439-525d-4339-8697-ae90c854d021

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Turns = COUNTROWS ( fact_utterance )
		formatString: 0
		lineageTag: 576878da-7047-4830-8e25-bd7fe9cb492e

		changedProperty = Name

	measure 'Share of Hearing' = DIVIDE ( [Speaking Minutes], CALCULATE ( [Speaking Minutes], REMOVEFILTERS ( fact_utterance[side] ) ) )
		lineageTag: 570da1ae-87ce-4915-a11e-f8beab32acf2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Words per Minute' = DIVIDE ( SUM ( fact_utterance[word_count] ), [Speaking Minutes] )
		lineageTag: 667d7cf1-e303-4a83-b1d1-3c0ad14ec3cf

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

